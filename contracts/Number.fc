#include "./imports/stdlib.fc";

const op::change_number = "op::change_number"c;
const op::change_number_notification = "op::change_number_notification"c;

(int) load_data() inline {
    slice ds = get_data().begin_parse();
    return ds~load_uint(8);
}

() save_data(int number) impure {
    set_data(
        begin_cell()
        .store_uint(number, 8)
        .end_cell()
    );
}

() change_number(int number) impure {
    save_data(number);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);

    if (op == op::change_number) {
        int number = in_msg_body~load_uint(8);
        change_number(number);
        cell event = begin_cell()
                    .store_uint(op::change_number_notification, 32)
                    .store_slice("ChangedNumber")
                    .store_uint(number, 8)
                    .end_cell();
        var msg = begin_cell()
                .store_uint(0x18, 6)
                .store_slice(sender_address)
                .store_coins(0)
                .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(event)
                .end_cell();
        send_raw_message(msg, 64);
        return ();
    }

    return ();
}

(int) get_number() method_id {
    return load_data();
}
